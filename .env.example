# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Shared secret our backend sends as X-API-Key. Long and random.
CHAT_API_KEY=change-me-long-random-string

# LLM provider: groq | openrouter, and the key for the chosen one.
LLM_PROVIDER=groq
GROQ_API_KEY=<groq-api-key>
# OPENROUTER_API_KEY=<openrouter-api-key>

# Leak markers the output guard blocks, on top of the generic checks in code.
# Comma-separated; required on staging/prod.
LEAK_INTERNAL_PORTS=<port>,<port>
LEAK_INTERNAL_NAMES=<storage-bucket-name>,<internal-file-prefix>

# --- Optional (defaults shown) ---------------------------------------------
# CORPUS_DIR=corpus     # default: the repo's corpus/ (/app/corpus in the image)
# CHAT_MODEL=openai/gpt-oss-20b
# PUBLIC_BASE_URL=https://trendwise.io   # unconfirmed
# SALES_EMAIL=sales@trendwise.io
# CHAT_TIMEOUT_S=45
# SESSION_MAX_TURNS=10
# SESSION_TTL_S=1800
# LLM_MAX_RETRIES=1
# RATE_LIMIT_RPM=30
# DOCS_ENABLED=false     # true only in your local .env; never staging/prod
